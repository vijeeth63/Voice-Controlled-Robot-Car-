# Shared secret — must match VITE_API_KEY in the frontend
BRIDGE_API_KEY=change-me-to-a-long-random-string

# ESP32 base URL on your LAN
ESP32_BASE_URL=http://192.168.1.192

# HTTP timeouts (seconds)
ESP32_HTTP_CONNECT_TIMEOUT=2
ESP32_HTTP_READ_TIMEOUT=12

# Allowed origins — add your Vercel URL when deploying
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
